    {
      "type": "timeseries",
      "title": "Arrivals vs completions",
      "description": "If enqueued stays above completed, the backlog grows without bound (utilisation > 1).",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_jobs_enqueued_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "enqueued"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_jobs_completed_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "completed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_jobs_failed_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "failed attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Queue state",
      "description": "Right axis: entries physically retained. Approximate trimming removes whole 100-entry nodes, so it saw-tooths between ~0 and ~100; if it climbs steadily, trimming has stopped.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue) (distqueue_queue_backlog{queue=~\"$queue\"}))",
          "refId": "A",
          "legendFormat": "backlog"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue) (distqueue_pending_entries{queue=~\"$queue\"}))",
          "refId": "B",
          "legendFormat": "in flight"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(distqueue_delayed_jobs)",
          "refId": "C",
          "legendFormat": "delayed"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue) (distqueue_stream_length{queue=~\"$queue\"}))",
          "refId": "D",
          "legendFormat": "retained in stream"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "retained in stream"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
