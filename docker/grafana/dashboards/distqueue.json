    {
      "type": "timeseries",
      "title": "Reclaims, fencing, Redis errors",
      "description": "Zero in normal operation. 'stale writes rejected' = a worker reported a job the monitor had already reclaimed.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_jobs_reclaimed_total{reason=\"worker_death\",queue=~\"$queue\"}[$__rate_interval])) or vector(0)",
          "refId": "A",
          "legendFormat": "reclaimed: worker died"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_jobs_reclaimed_total{reason=\"timeout\",queue=~\"$queue\"}[$__rate_interval])) or vector(0)",
          "refId": "B",
          "legendFormat": "reclaimed: timed out"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_lease_lost_total{queue=~\"$queue\"}[$__rate_interval])) or vector(0)",
          "refId": "C",
          "legendFormat": "stale writes rejected (fencing)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(distqueue_redis_errors_total[$__rate_interval])) or vector(0)",
          "refId": "D",
          "legendFormat": "redis errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
